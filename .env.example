# ============================================================
# DashTab POS – Backend Environment Variables (.env.example)
# Copy to .env and fill in real values. NEVER commit .env.
# The ASP.NET backend reads these via the configuration system.
# ============================================================

# ─── PostgreSQL (Supabase backend database) ──────────────────
# Use the "Connection string (direct)" from Supabase →
# Project Settings → Database. Format:
# Host=aws-0-<region>.pooler.supabase.com;Port=6543;Database=postgres;Username=postgres.<ref>;Password=<password>
ConnectionStrings__DefaultConnection=Host=localhost;Database=dashtab;Username=dashtab;Password=Password123!

# ─── Supabase ─────────────────────────────────────────────────
# Project URL   (https://<project-ref>.supabase.co)
Supabase__Url=https://kiufyhsuwolgpksjnlqk.supabase.co

# JWT secret (used to validate Supabase access tokens on backend endpoints).
# Found in: Supabase → Project Settings → API → JWT Secret.
Supabase__JwtSecret=YOUR_SUPABASE_JWT_SECRET

# Service-role key (server-to-server business operations).
# NEVER expose this to Flutter. Found in: Supabase → Project Settings → API.
Supabase__ServiceRoleKey=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ─── Environment ──────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development
